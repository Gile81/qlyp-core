      "your_ride_subtotal_ht": "number",
      "passenger_paid_total_ttc": "number",
      "retained_total": "number",
      "toll": "BillingTollSnapshot|null",
      "tip": "number",
      "paid_to_driver": "number",
      "driver_taxes_to_remit": "BillingTaxLine[]",
      "driver_taxes_to_remit_total": "number",
      "driver_revenue": "number",
      "qlyp_promo_subsidy": "number",
      "cash_collected_by_driver": "boolean",
      "cash_due_to_qlyp": "number",
      "cash_collected_label_fr": "string optional",
      "cash_collected_label_en": "string optional",
      "cash_due_label_fr": "string optional",
      "cash_due_label_en": "string optional",
      "payment": "BillingDocumentPayment",
      "legal": "object",
      "retain_until": "string ISO",
      "retention_years": "number",
      "pdf_path": "string|null",
      "pdf_status": "pending|ready|error",
      "pdf_error": "string optional",
      "pdf_error_code": "string optional"
    }
  },
  "error_codes": {
    "firm_bid_missing_quote_breakdown": "Firm bid accept or coupon without stamped price_breakdown / price_breakdown_solo",
    "invalid_request": "getBillingDocumentUrl invalid input",
    "not_found": "Billing document or order not found",
    "permission_denied": "getBillingDocumentUrl caller not owner",
    "pdf_not_ready": "PDF path or status not ready for signed URL",
    "max_attempts_exceeded": "order financials write attempts exhausted",
    "blocked_quote_refresh": "financials blocked until quote refresh completes",
    "quote_refresh_pending": "financials deferred while quote_refresh_status pending",
    "quote_refresh_error": "financials blocked after quote refresh error"
  }
}
